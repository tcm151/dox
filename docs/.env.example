# General app config
PORT=3000
BASE_URL=http://localhost:3000

SITE_TITLE=ClassicForum
SITE_TITLE_SHORT=OF

# Database mode
# embedded (default): rocksdb:///app/data/classicforum.db (Docker) or rocksdb://./data/classicforum.db (local)
# remote example: http://localhost:8000/rpc
SURREAL_TYPE=embedded
SURREAL_URL=rocksdb://./data/classicforum.db
SURREAL_NAMESPACE=classicforum
SURREAL_DATABASE=development

# Only required for remote SurrealDB mode
SURREAL_USERNAME=
SURREAL_PASSWORD=

# Startup default admin bootstrap
DEFAULT_USER_EMAIL=admin@example.com
DEFAULT_USER_NAME=Admin
DEFAULT_USER_PASSWORD=change-me-now

# Where media (and embedded db files) are stored
MEDIA_PATH=./data

# Optional SMTP config for email
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_TITLE=