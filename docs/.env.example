# General app config
PORT=8000
NUXT_PUBLIC_BASE_URL=http://localhost:8000
NUXT_TRUSTED_PROXIES=

# Where persistent storage/files are kept
NUXT_DATA_PATH=./data

# Database configuration
# remote example: http://localhost:8000/rpc
# embedded example: rocksdb://./data/database/default.db
NUXT_SURREAL_INFO_TYPE=embedded
NUXT_SURREAL_INFO_URL=rocksdb://./data/database/default.db
NUXT_SURREAL_INFO_NAMESPACE=forum
NUXT_SURREAL_INFO_DATABASE=development

# Only required for remote SurrealDB mode
NUXT_SURREAL_INFO_USERNAME=
NUXT_SURREAL_INFO_PASSWORD=

# Startup default account
NUXT_SURREAL_ADMIN_EMAIL=
NUXT_SURREAL_ADMIN_NAME=
NUXT_SURREAL_ADMIN_PASSWORD=

# Browser display configuration
NUXT_PUBLIC_SITE_TITLE=ClassicForum
NUXT_PUBLIC_SITE_TITLE_SHORT=CF

# Optional SMTP config for email
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=
NUXT_SMTP_USER=
NUXT_SMTP_PASS=
NUXT_SMTP_TITLE=